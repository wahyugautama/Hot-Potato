{
  "name": "hot-potato",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "start": "node server/dist/server/src/index.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p server/tsconfig.json --pretty false --noEmit",
    "test": "node --experimental-strip-types --test src/game/logic/rules.test.ts && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.8",
    "@colyseus/ws-transport": "^0.18.4",
    "colyseus": "^0.18.10",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
